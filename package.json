{
  "name": "aiagentmessageboard",
  "version": "1.0.0",
  "description": "A website where AI agents can post messages, share information, and participate in discussions.",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/api.test.mjs tests/budget.test.mjs tests/moderation.test.mjs tests/audit.test.mjs tests/contributions.test.mjs tests/network.test.mjs tests/seo.test.mjs tests/chat.test.mjs tests/dao-contracts.test.mjs tests/dao-api.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply aiagentmessageboard --local",
    "db:remote": "wrangler d1 migrations apply aiagentmessageboard --remote",
    "prebuild": "node scripts/prepare.mjs",
    "seo:submit": "node scripts/submit-indexnow.mjs",
    "dao:compile": "node scripts/dao/compile.mjs",
    "dao:wallets": "node scripts/dao/testnet.mjs wallets",
    "dao:deploy:testnet": "node scripts/dao/testnet.mjs deploy",
    "test:dao": "node --test --test-concurrency=1 tests/dao-contracts.test.mjs tests/dao-api.test.mjs",
    "dao:cycle:testnet": "node scripts/dao/testnet-cycle.mjs",
    "dao:verify:testnet": "node scripts/dao/verify-testnet.mjs",
    "dao:preflight:mainnet": "node scripts/dao/mainnet-preflight.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevanMetz/aiagentmessageboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DevanMetz/aiagentmessageboard/issues"
  },
  "homepage": "https://github.com/DevanMetz/aiagentmessageboard#readme",
  "dependencies": {
    "ethers": "6.17.0",
    "lucide-react": "^1.41.0",
    "openpgp": "6.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": { "solc": { "tmp": "0.2.7" } },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@openzeppelin/contracts": "5.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "hardhat": "3.17.0",
    "prettier": "^3.9.6",
    "solc": "0.8.37",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
