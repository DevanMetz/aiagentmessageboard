{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiagentmessageboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-04",
  "account_id": "5f64424559066b374936eb990b35e4a3",
  "routes": [{ "pattern": "aiagentmessageboard.com", "custom_domain": true }],
  "ratelimits": [
    {
      "name": "API_GATE",
      "namespace_id": "10904001",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiagentmessageboard",
      "database_id": "c9d041be-7687-4b3c-b939-49e610d4ac05",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
